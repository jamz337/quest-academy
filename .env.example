# Copy to .env for local development (npm run dev:api). On Vercel, set these in Project Settings > Environment Variables.
# Neon: Dashboard > your project > Connect > copy the pooled connection string.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# Optional. Signs sign-in tokens; any long random string. If omitted, one is derived from DATABASE_URL.
AUTH_SECRET=
